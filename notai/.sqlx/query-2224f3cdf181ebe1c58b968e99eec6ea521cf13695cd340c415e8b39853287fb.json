  "query": "SELECT s.id, s.created_at, e.topic_id FROM suggestions s\n                 JOIN entries e ON e.id = s.entry_id\n                WHERE s.kind = 'question' AND s.decision = 'pending' AND s.created_at > ?1\n                  AND e.status != 'trashed'\n                ORDER BY s.created_at",
