  "query": "SELECT id, text, source, captured_at, topic_id, status, trashed_at, author\n             FROM entries\n             WHERE ai_state = 'pending' AND status != 'trashed'\n               AND (ai_next_at IS NULL OR ai_next_at <= ?1)\n             ORDER BY captured_at LIMIT 1",
